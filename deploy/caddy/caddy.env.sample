# Caddy environment for the Nipa edge. Install as /etc/caddy/caddy.env (0640
# root:caddy); deploy/caddy/caddy.service.d/nipa.conf loads it into
# caddy.service and deploy/upgrade.sh passes it to `caddy validate --envfile`.
#
# The Netlify site origin of the marketing site. Never https://nipalab.com:
# Caddy owns that host and would proxy back into itself.
MARKETING_UPSTREAM=https://example.netlify.app
