# Nipa SaaS edge: terminates TLS for the single h2c nipad-ee port and proxies to
# the active blue/green color. deploy/upgrade.sh rewrites the nipad-ee upstream
# line between flips and reloads Caddy; a reload never drops established
# connections.
#
# The marketing site is a separate Netlify deployment (nipa-web repo): the bare
# root and its /_astro/* build assets are proxied there, so marketing changes go
# live with a Netlify deploy instead of a nipad-ee rebuild. Caddy owns
# nipalab.com, so MARKETING_UPSTREAM must be the Netlify site origin, never
# https://nipalab.com (that would proxy Caddy back into itself). Configure it
# in /etc/caddy/caddy.env (deploy/caddy/caddy.env.sample), loaded by the
# caddy.service drop-in (deploy/caddy/caddy.service.d/nipa.conf) and by
# upgrade.sh's `caddy validate --envfile`:
#     MARKETING_UPSTREAM=https://<site>.netlify.app
#
# The marketing build lists its routes with `npm run routes` (nipa-web); keep
# @marketing in sync with it and with the reserved org slugs.
#
# Keep the nipad-ee reverse_proxy line in the exact
#     reverse_proxy 127.0.0.1:<port> {
# shape: upgrade.sh matches it with sed. The marketing upstream never matches.
{
	email admin@nipalab.com
}

nipalab.com {
	encode zstd gzip

	# Caddy already redacts Authorization/Cookie headers; also drop the
	# secrets carried in query strings (email confirmation tokens, OAuth
	# codes/state, presigned chunk URL signatures) and the Referer header,
	# which repeats the page URL on same-origin subrequests.
	log {
		output stdout
		format filter {
			wrap json
			fields {
				request>uri query {
					delete token
					delete code
					delete state
					delete sig
				}
				request>headers>Referer delete
			}
		}
	}

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		X-Frame-Options DENY
		-Server
	}

	# Keep the observability endpoints off the public edge: probe the loopback
	# ports instead. /debug/pprof only exists when PPROF_ENABLED=true.
	@internal path /metrics /readyz /debug/pprof /debug/pprof/*
	respond @internal 404

	# Marketing lives on Netlify. Caddy mirrors its landing page, page routes,
	# and assets; every marketing page link is absolute to nipalab.com. The app
	# owns every other path. Keep this list in sync with the marketing build and
	# with the reserved org slugs (internal/usecase/reserved.go, web/src/slug.ts).
	# MARKETING_UPSTREAM is required and must not be nipalab.com.
	@marketing path / /_astro/* /screenshots/* /pricing /pricing/* /guides /guides/* /download /download/* /support /support/* /contact /contact/* /privacy /privacy/* /terms /terms/* /favicon.svg /legal.json /apple-touch-icon.png /logo.svg /og.png /robots.txt /site.webmanifest /sitemap-index.xml /sitemap-0.xml
	handle @marketing {
		# Netlify routes by Host, so send the upstream's own host: the site
		# needs no nipalab.com alias.
		reverse_proxy {$MARKETING_UPSTREAM} {
			header_up Host {upstream_hostport}
		}
	}

	reverse_proxy 127.0.0.1:8001 {
		transport http {
			versions h2c 2
			read_timeout 0
			write_timeout 0
		}
		# Stream responses (gRPC, long REST calls) without buffering.
		flush_interval -1
		# Stop routing to a backend that reports /readyz unhealthy, including
		# while one color drains during an upgrade.
		health_uri /readyz
		health_interval 5s
		health_timeout 2s
		# Hold a request for up to 5s while the upstream is briefly unavailable
		# (restart or failed health check) instead of failing it immediately.
		lb_try_duration 5s
	}
}
