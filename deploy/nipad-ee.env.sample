# Color instance environment for the nipad-ee@.service systemd template unit.
# Copy to /etc/nipa/blue.env and /etc/nipa/green.env, one file per color, and
# set SERVER_PORT to the color's port (blue 8001, green 8002 by default).
# Shared settings (DATABASE_DSN, CHUNK_S3_*, JWT_KEY, MFA_ENCRYPTION_KEY,
# SAAS_MODE, ...) belong in /etc/nipa/config.yaml or /etc/nipa/.env, not here.

# Two-factor authentication (TOTP), listed next to JWT_KEY for reference; both
# are shared settings. MFA is on by default on nipad-ee and the key is then
# required (base64 of at least 32 bytes: `openssl rand -base64 32`). Both
# colors must use the same key. Losing or changing it disables every enrolled
# user's second factor until an admin resets it. The server clock must be
# NTP-synced: drift beyond 30 s breaks enrolled logins.
#MFA_ENABLED=true
#MFA_ENCRYPTION_KEY=replace_me_with_openssl_rand_base64_32

SERVER_ADDRESS=127.0.0.1
SERVER_PORT=8001

# Graceful shutdown budget for in-flight operations (pushes, merges) during a
# blue-green flip; it bounds the whole shutdown (requests, dispatchers,
# exporter flush). Keep it larger than the longest operation you expect; the
# unit's TimeoutStopSec must stay above it.
SHUTDOWN_TIMEOUT_SECONDS=60

# Optional: serve /metrics and /debug/pprof on their own loopback port instead
# of SERVER_PORT (which then answers 404 for them). One port per color, e.g.
# blue 9101, green 9102; point the scraper at it.
#METRICS_ADDRESS=9101

# Chunk read-backs all confirms together run at once on this color (default 64;
# <= 0 means the default). Each chunk a client uploads directly is read back
# and hashed at confirm, so with R2/S3 latency this limit sets the confirm
# rate. Usually a shared setting; listed here for reference.
#CHUNK_VERIFY_CONCURRENCY=64

# Upload path for the SaaS default (R2) bucket: proxy sends chunk bytes
# through the server in bundles (many chunks per request), which hashes them,
# writes R2 itself (one pack object per bundle with CHUNK_PACKS=on, else one
# object per chunk) and returns receipts so
# confirm reads nothing back; direct hands
# out presigned R2 URLs and reads every chunk back at confirm. Bring-your-own
# storage projects always upload direct. Provisional: the final default is
# decided after the push-throughput loadtest rerun (MinIO, R2 direct, R2
# proxy). Shared setting: both colors must agree. Caddy must not cap request
# bodies below CHUNK_BUNDLE_MAX_MIB (64 MiB by default, the largest bundle).
CHUNK_UPLOAD_MODE=proxy
# Bundle upload bodies held in memory at once, server-wide (MiB, default 256).
#CHUNK_PROXY_BUFFER_MIB=256
# Largest bundle upload body a presign signs (MiB, default 64).
#CHUNK_BUNDLE_MAX_MIB=64
# Chunk packs: each bundle (and each merge's output) becomes one R2 object of
# many chunks, and clones read them with merged Range requests (one Class A
# write per bundle instead of one per chunk). Requires CHUNK_UPLOAD_MODE=proxy;
# nipad-ee refuses to start otherwise. Shared setting: both colors must agree.
# Turned on once the loadtest rerun passes.
#CHUNK_PACKS=on
# Loose chunk writes (packs off) running at once, server-wide (default 64).
#CHUNK_STORE_WRITE_CONCURRENCY=64

# Do NOT set SNOWFLAKE_NODE_ID: the two colors run concurrently during a flip
# and lease distinct node ids from postgres. A fixed id would let them collide.

# Terms of service and privacy policy version users accept at sign-up. The
# website publishes it (nipa-web LEGAL.version); the server follows the URL and
# uses SAAS_TERMS_VERSION only until the first successful fetch. Shared settings.
#SAAS_TERMS_URL=https://nipalab.com/legal.json
#SAAS_TERMS_VERSION=2026-11-10

# Billing (Paddle). Shared settings: both colors must use the same values, so
# normally they live in /etc/nipa/.env; they are listed here for reference.
# Placeholders only: real keys and prices never go into the repository.
# BILLING_PROVIDER=paddle requires SAAS_MODE=1 and the storage ledger; every
# key below is then required and startup fails naming a missing one.
# The Paddle notification destination posts to https://<app-domain>/api/webhooks/paddle.
#BILLING_PROVIDER=off
#PADDLE_ENVIRONMENT=sandbox
#PADDLE_API_KEY=pdl_sdbx_apikey_replace_me
#PADDLE_WEBHOOK_SECRET=pdl_ntfset_replace_me
#PADDLE_CLIENT_TOKEN=test_replace_me
#PADDLE_PRICE_SEAT_MONTHLY=pri_replace_me
#PADDLE_PRICE_SEAT_YEARLY=pri_replace_me
#PADDLE_PRICE_STORAGE_MONTHLY=pri_replace_me
#PADDLE_PRICE_STORAGE_YEARLY=pri_replace_me
#PADDLE_PRICE_OWN_STORAGE_MONTHLY=pri_replace_me
#PADDLE_PRICE_OWN_STORAGE_YEARLY=pri_replace_me
#BILLING_FREE_SEATS=1
#BILLING_SEAT_INCLUDED_BYTES=1
#BILLING_STORAGE_PACK_BYTES=1
