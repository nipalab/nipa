# Color instance environment for the nipad-ee@.service systemd template unit.
# Copy to /etc/nipa/blue.env and /etc/nipa/green.env, one file per color, and
# set SERVER_PORT to the color's port (blue 8001, green 8002 by default).
# Shared settings (DATABASE_DSN, CHUNK_S3_*, JWT_KEY, SAAS_MODE, ...) belong in
# /etc/nipa/config.yaml or /etc/nipa/.env, not here.

SERVER_ADDRESS=127.0.0.1
SERVER_PORT=8001

# Graceful shutdown budget for in-flight operations (pushes, merges) during a
# blue-green flip; it bounds the whole shutdown (requests, dispatchers,
# exporter flush). Keep it larger than the longest operation you expect; the
# unit's TimeoutStopSec must stay above it.
SHUTDOWN_TIMEOUT_SECONDS=60

# Do NOT set SNOWFLAKE_NODE_ID: the two colors run concurrently during a flip
# and lease distinct node ids from postgres. A fixed id would let them collide.

# Billing (Paddle). Shared settings: both colors must use the same values, so
# normally they live in /etc/nipa/.env; they are listed here for reference.
# Placeholders only: real keys and prices never go into the repository.
# BILLING_PROVIDER=paddle requires SAAS_MODE=1 and the storage ledger; every
# key below is then required and startup fails naming a missing one.
# The Paddle notification destination posts to https://<app-domain>/api/webhooks/paddle.
#BILLING_PROVIDER=off
#PADDLE_ENVIRONMENT=sandbox
#PADDLE_API_KEY=pdl_sdbx_apikey_replace_me
#PADDLE_WEBHOOK_SECRET=pdl_ntfset_replace_me
#PADDLE_CLIENT_TOKEN=test_replace_me
#PADDLE_PRICE_SEAT_MONTHLY=pri_replace_me
#PADDLE_PRICE_SEAT_YEARLY=pri_replace_me
#PADDLE_PRICE_STORAGE_MONTHLY=pri_replace_me
#PADDLE_PRICE_STORAGE_YEARLY=pri_replace_me
#BILLING_FREE_SEATS=1
#BILLING_SEAT_INCLUDED_BYTES=1
#BILLING_STORAGE_PACK_BYTES=1
