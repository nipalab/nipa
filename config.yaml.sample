SERVER_ADDRESS: 0.0.0.0
SERVER_PORT: 6745
# Public address clients use to reach this server (scheme, host and port as
# users type them). SSH key login signatures are bound to its host[:port]; when
# empty the host of EMAIL_BASE_URL is used, and SSH key login is refused if
# neither is set. See docs/SSH.md. Its origin is also the only one the REST API
# grants CORS to (a bare host means https; empty grants none). Neither server
# terminates TLS: put a TLS proxy in front (docs/DEPLOY.md).
PUBLIC_BASE_URL: ''
# Slowloris guard: seconds a client may take to send the request headers
# (default 30). Idle keep-alive connections are closed after
# HTTP_IDLE_TIMEOUT_SECONDS (default 300); on h2c only connections without an
# active stream (gRPC clients reconnect transparently). There is deliberately no
# read/write timeout: it would cut long chunk transfers and gRPC streams.
HTTP_READ_HEADER_TIMEOUT_SECONDS: 30
HTTP_IDLE_TIMEOUT_SECONDS: 300
# Graceful shutdown drain window in seconds (default 15): on SIGTERM /readyz
# answers 503 and in-flight requests get this long to finish. For zero-downtime
# blue/green upgrades keep the unit's TimeoutStopSec above it (docs/DEPLOY.md).
SHUTDOWN_TIMEOUT_SECONDS: 15
# SQLite file path for the free `nipad`; postgres connection string for the
# enterprise `nipad-ee`.
DATABASE_DSN: nipa.db
# Required: generate with `openssl rand -base64 48`. The server refuses to start
# on an empty, short or sample value (set ALLOW_INSECURE_DEV_SECRETS: true for
# throwaway local development only).
JWT_KEY: ''
ALLOW_INSECURE_DEV_SECRETS: false
# Logging: level is debug|info|warn|error, format is console|json.
LOG_LEVEL: debug
LOG_FORMAT: console
# Serve net/http/pprof on /debug/pprof/ of the main port; keep off outside
# trusted networks.
PPROF_ENABLED: false
# Serve Prometheus metrics on /metrics of the main port.
METRICS_ENABLED: true
# Separate listener for /metrics and /debug/pprof (both unauthenticated); the
# main port then answers 404 for them. A bare port (`9101` or `:9101`) binds
# 127.0.0.1, `host:port` binds as given. Empty keeps them on the main port.
METRICS_ADDRESS: ''
# Export OpenTelemetry spans over OTLP (docs/TRACING.md). Disabled keeps the
# process on the no-op tracer. TRACING_STDOUT pretty-prints spans to stderr
# instead of exporting; the endpoint accepts host:port or a URL (https:// for
# TLS, bare host or http:// for plaintext). Empty falls back to the standard
# OTEL_EXPORTER_OTLP_ENDPOINT / OTEL_EXPORTER_OTLP_TRACES_ENDPOINT variables,
# then to localhost:4317 (gRPC) or localhost:4318 (HTTP). TRACING_OTLP_PROTOCOL
# selects `grpc` (default) or `http`; an HTTP endpoint may carry a path prefix
# (e.g. OpenObserve's /api/<org>).
TRACING_ENABLED: false
TRACING_OTLP_ENDPOINT: ''
TRACING_OTLP_PROTOCOL: ''
TRACING_STDOUT: false
TRACING_SAMPLE_RATIO: 1.0
TRACING_SERVICE_NAME: ''
# Extra headers sent with every OTLP request, comma-separated KEY=VALUE pairs
# (e.g. "Authorization=Basic <base64>" for OpenObserve; add organization=<org>
# on gRPC). Shared by traces and logs.
TRACING_OTLP_HEADERS: ''
# Ship structured logs over OTLP alongside the local console/JSON output
# (docs/OBSERVABILITY.md). Endpoint and protocol default to the TRACING_*
# values; the headers are TRACING_OTLP_HEADERS.
LOGS_OTLP_ENABLED: false
LOGS_OTLP_ENDPOINT: ''
LOGS_OTLP_PROTOCOL: ''
# Push the Prometheus registry straight to the OTLP backend (no collector or
# Prometheus needed). Endpoint and protocol default to the TRACING_* values,
# headers are TRACING_OTLP_HEADERS; the interval is the push cadence in
# seconds. Independent of METRICS_ENABLED, which keeps serving /metrics.
METRICS_OTLP_ENABLED: false
METRICS_OTLP_ENDPOINT: ''
METRICS_OTLP_PROTOCOL: ''
METRICS_OTLP_INTERVAL_SECONDS: 30
# Snowflake node id. The free `nipad` is single-instance and uses this value.
# `nipad-ee` uses it when set; remove the key (or leave the env var empty) to
# have each instance lease its own id from postgres, which is what a multi-pod
# deployment needs.
SNOWFLAKE_NODE_ID: 0
# TTL in seconds of the enterprise auto-assigned node id lease.
SNOWFLAKE_LEASE_TTL_SECONDS: 60
HASHER_WORKERS: 4
# Chunk backend. The free `nipad` supports `local` only; the enterprise
# `nipad-ee` supports `s3` only (empty defaults to s3 there).
CHUNK_STORAGE: local
CHUNK_STORAGE_DIR: ./chunks
# S3-compatible chunk backend (enterprise `nipad-ee` only).
# Endpoint may include a scheme; bare hosts default to https.
CHUNK_S3_ENDPOINT: ''
CHUNK_S3_REGION: ''
CHUNK_S3_BUCKET: ''
CHUNK_S3_PREFIX: ''
# Leave the static credentials empty to use the AWS environment and
# EC2/ECS instance metadata providers.
CHUNK_S3_ACCESS_KEY_ID: ''
CHUNK_S3_SECRET_ACCESS_KEY: ''
# Required: a different value from JWT_KEY (`openssl rand -base64 48`).
CHUNK_URL_SIGNING_KEY: ''
CHUNK_PRESIGN_TTL_SECONDS: 3600
CHUNK_MAX_PAGE_SIZE: 1000
# Enterprise storage accounting and quota (`nipad-ee` only, see
# docs/CLOUD_STORAGE_QUOTA.md). Empty disables the ledger and its
# /orgs/{org}/storage and /billing/me routes; `cloud` tracks usage per
# project/org/owner and enforces the owner quota. SAAS_MODE turns it on
# automatically so the seeded free-tier quota is enforced and visible.
STORAGE_LEDGER: ''
# Quota in bytes for owners without an explicit quota row (default
# 16106127360 = 15 GiB; set 0 for unlimited).
STORAGE_LEDGER_DEFAULT_QUOTA_BYTES: 16106127360
# Comma-separated hostnames, IPs or CIDR ranges webhooks may reach. Empty
# allows public addresses only; loopback/private targets need an entry.
WEBHOOK_EGRESS_ALLOWLIST: ''
WEBHOOK_TIMEOUT_SECONDS: 30
# Outbound email. EMAIL_SENDER selects the transport: `off` (default), `log`,
# `smtp`, `sendgrid`, `scaleway` or `http` (a generic REST sender configured
# with a body template). See docs/EMAIL.md for provider examples.
EMAIL_SENDER: 'off'
EMAIL_FROM: 'Nipa <noreply@example.com>'
EMAIL_REPLY_TO: ''
# Public base URL of the web UI, used for links in notification emails.
EMAIL_BASE_URL: ''
EMAIL_TIMEOUT_SECONDS: 10
# Outbox delivery: total attempts per message, the delay before a retry and
# how often due deliveries are polled (zero keeps the built-in defaults).
EMAIL_MAX_ATTEMPTS: 0
EMAIL_RETRY_BACKOFF_SECONDS: 0
EMAIL_POLL_SECONDS: 0
# SMTP transport. TLS is `starttls` (default), `ssl` (implicit TLS) or
# `none`; the port defaults to 587, 465 and 25 respectively.
EMAIL_SMTP_HOST: ''
EMAIL_SMTP_PORT: 0
EMAIL_SMTP_USERNAME: ''
EMAIL_SMTP_PASSWORD: ''
EMAIL_SMTP_TLS: starttls
# Allow self-signed SMTP certificates; keep off outside development.
EMAIL_SMTP_INSECURE_SKIP_VERIFY: false
# SendGrid v3 API transport.
EMAIL_SENDGRID_API_KEY: ''
# Override the API base URL (defaults to https://api.sendgrid.com).
EMAIL_SENDGRID_ENDPOINT: ''
# Scaleway Transactional Email transport (REST API). The API key is a secret
# key with the TransactionalEmailFullAccess permission and the project must
# own the verified sending domain; region defaults to fr-par.
EMAIL_SCALEWAY_API_KEY: ''
EMAIL_SCALEWAY_PROJECT_ID: ''
EMAIL_SCALEWAY_REGION: ''
# Override the API base URL (defaults to https://api.scaleway.com).
EMAIL_SCALEWAY_ENDPOINT: ''
# Generic HTTP transport: the body template is rendered per recipient with
# {{.From}}/{{.FromEmail}}/{{.To}}/{{.ToHeader}}/{{.Subject}}/{{.Text}}/
# {{.HTML}}/{{.MessageID}}/{{.InReplyTo}}/{{.References}} and a `json` helper.
EMAIL_HTTP_ENDPOINT: ''
EMAIL_HTTP_METHOD: POST
EMAIL_HTTP_HEADERS: ''
EMAIL_HTTP_CONTENT_TYPE: application/json
EMAIL_HTTP_BODY_TEMPLATE: ''
# SaaS onboarding (`nipad-ee` only, see docs/SAAS_ONBOARDING.md). SAAS_MODE=1
# enables self-registration with email confirmation and the social login
# routes; existing deployments keep it off. Registration needs EMAIL_BASE_URL
# (the confirmation link) and a configured EMAIL_SENDER to deliver it. SaaS
# mode also enables the cloud storage ledger (see STORAGE_LEDGER above).
SAAS_MODE: false
# Free-tier storage quota seeded for every self-registered account (bytes).
SAAS_FREE_QUOTA_BYTES: 16106127360
# Public base URL used to build OAuth callback URLs. Social login providers
# are enabled per client id/secret pair; all four values are required for a
# provider to appear (Google and GitHub are supported).
OAUTH_BASE_URL: ''
OAUTH_GOOGLE_CLIENT_ID: ''
OAUTH_GOOGLE_CLIENT_SECRET: ''
OAUTH_GITHUB_CLIENT_ID: ''
OAUTH_GITHUB_CLIENT_SECRET: ''
# Rate limiting (design in docs/RATE_LIMIT.md). Token buckets per scope; rates
# are tokens per minute. RATE_LIMIT_STORE is `memory` (per process, default) or
# `redis` (nipad-ee only; shared between instances). On nipad-ee an unset store
# picks redis when RATE_LIMIT_REDIS_ADDR is set. A store failure never blocks
# requests (fail open), except the auth scopes, which fall back to a
# per-process store.
RATE_LIMIT_ENABLED: true
RATE_LIMIT_STORE: ''
RATE_LIMIT_REDIS_ADDR: ''
RATE_LIMIT_REDIS_PASSWORD: ''
RATE_LIMIT_REDIS_DB: 0
RATE_LIMIT_REDIS_TLS: false
RATE_LIMIT_REDIS_PREFIX: 'nipa:rl:'
# X-Forwarded-For is honoured only from these peers (comma-separated IPs or
# CIDRs); the reverse proxy in front of nipad must be listed.
RATE_LIMIT_TRUSTED_PROXIES: '127.0.0.1,::1'
# Login, refresh, SSH challenge and registration routes, per client IP.
RATE_LIMIT_AUTH_IP_PER_MINUTE: 10
RATE_LIMIT_AUTH_IP_BURST: 10
# Password and SSH logins and password changes per account email and client
# IP (email only when the client IP is unknown).
RATE_LIMIT_AUTH_ID_PER_MINUTE: 0.33
RATE_LIMIT_AUTH_ID_BURST: 5
# Password and SSH logins per account email from every IP: a ceiling for
# distributed guessing against one account.
RATE_LIMIT_AUTH_EMAIL_PER_MINUTE: 1
RATE_LIMIT_AUTH_EMAIL_BURST: 20
# SaaS registration and confirmation resends per email address.
RATE_LIMIT_REGISTER_EMAIL_PER_MINUTE: 0.1
RATE_LIMIT_REGISTER_EMAIL_BURST: 3
# Authenticated REST and gRPC calls, per user.
RATE_LIMIT_API_USER_PER_MINUTE: 3000
RATE_LIMIT_API_USER_BURST: 200
# Signed chunk transfers, per client IP.
RATE_LIMIT_CHUNK_IP_PER_MINUTE: 60000
RATE_LIMIT_CHUNK_IP_BURST: 5000
# Every other HTTP request (web UI, REST), per client IP.
RATE_LIMIT_GLOBAL_IP_PER_MINUTE: 6000
RATE_LIMIT_GLOBAL_IP_BURST: 300
# Organization invitations: creating or resending, per inviting user.
RATE_LIMIT_INVITE_USER_PER_MINUTE: 0.5
RATE_LIMIT_INVITE_USER_BURST: 20
# Invitations to one email address, across every organization.
RATE_LIMIT_INVITE_EMAIL_PER_MINUTE: 0.1
RATE_LIMIT_INVITE_EMAIL_BURST: 3
# Invitation previews, accepts and declines, per user.
RATE_LIMIT_INVITE_TOKEN_PER_MINUTE: 20
RATE_LIMIT_INVITE_TOKEN_BURST: 10
