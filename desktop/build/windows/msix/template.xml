<?xml version="1.0" encoding="utf-8"?>
<MsixPackagingToolTemplate
    xmlns="http://schemas.microsoft.com/msix/packaging/msixpackagingtool/template/2022">
    <Settings
        AllowTelemetry="false"
        ApplyACLsToPackageFiles="true"
        GenerateCommandLineFile="true"
        AllowPromptForPassword="false">
    </Settings>
    <Installer
        Path="nipa-desktop"
        Arguments=""
        InstallLocation="C:\Program Files\Nipa Lab\Nipa">
    </Installer>
    <PackageInformation
        PackageName="Nipa"
        PackageDisplayName="Nipa"
        PublisherName="CN=Nipa Lab"
        PublisherDisplayName="Nipa Lab"
        Version="0.1.0.0"
        PackageDescription="Version control for game teams">
        <Capabilities>
            <Capability Name="runFullTrust" />
            
        </Capabilities>
        <Applications>
            <Application
                Id="com.nipalab.nipa"
                Description="Version control for game teams"
                DisplayName="Nipa"
                ExecutableName="nipa-desktop"
                EntryPoint="Windows.FullTrustApplication">
                
            </Application>
        </Applications>
        <Resources>
            <Resource Language="en-us" />
        </Resources>
        <Dependencies>
            <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.19041.0" />
        </Dependencies>
        <Properties>
            <Framework>false</Framework>
            <DisplayName>Nipa</DisplayName>
            <PublisherDisplayName>Nipa Lab</PublisherDisplayName>
            <Description>Version control for game teams</Description>
            <Logo>Assets\AppIcon.png</Logo>
        </Properties>
    </PackageInformation>
    <SaveLocation PackagePath="nipa-desktop.msix" />
    <PackageIntegrity>
        <CertificatePath></CertificatePath>
    </PackageIntegrity>
</MsixPackagingToolTemplate>
